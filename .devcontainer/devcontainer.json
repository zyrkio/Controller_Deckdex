{
	"name": "PlatformIO DevContainer",
	"build": {
	  "dockerfile": "Dockerfile"
	},
	"runArgs": [
	  "--device=/dev/ttyACM0",
	  "--group-add=dialout"
	],
	"remoteUser": "vscode",
	"customizations": {
	  "vscode": {
		"extensions": [
		  "platformio.platformio-ide"
		]
	  }
	},
	"postCreateCommand": "pio lib install \"teemuatlut/TMCStepper@^0.7.3\" || true"
  }
  